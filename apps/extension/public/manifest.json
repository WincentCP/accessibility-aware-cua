{
  "manifest_version": 3,
  "name": "Accessibility-Aware CUA Research Shell",
  "short_name": "A11y CUA",
  "version": "0.5.0",
  "description": "Accessible side-panel shell for the local CUA research prototype.",
  "permissions": ["activeTab", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Buka Accessibility-Aware CUA"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
