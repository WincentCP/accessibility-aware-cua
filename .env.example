# Salin menjadi .env. Jangan commit .env atau memakai kredensial/profil pribadi.
CUA_ENV=development
CUA_APP_SECRET=ganti-dengan-random-string-lokal-minimal-24-karakter
CUA_HOST=127.0.0.1
CUA_PORT=8000
CUA_REQUIRE_POSTGRES=false
DATABASE_URL=postgresql://cua:cua_local_only@127.0.0.1:5432/cua
CUA_BROWSER_PROFILE_DIR=.runtime/playwright-profile
CUA_BROWSER_HEADLESS=false
# Checkpoint LangGraph menolak deserialisasi object arbitrary dari database.
LANGGRAPH_STRICT_MSGPACK=true
# Dokumentasi kebijakan: raw audio 0 hari, audit 90 hari, transcript 30 hari.
CUA_AUDIT_RETENTION_DAYS=90
CUA_TRANSCRIPT_RETENTION_DAYS=30
