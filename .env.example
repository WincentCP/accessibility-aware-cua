# Salin menjadi .env. Jangan commit .env atau memakai kredensial/profil pribadi.
CUA_ENV=development
CUA_APP_SECRET=ganti-dengan-random-string-lokal-minimal-24-karakter
CUA_HOST=127.0.0.1
CUA_PORT=8000
CUA_REQUIRE_POSTGRES=false
DATABASE_URL=postgresql://cua:cua_local_only@127.0.0.1:5432/cua
CUA_BROWSER_PROFILE_DIR=.runtime/playwright-profile
CUA_BROWSER_HEADLESS=false
CUA_BROWSER_BRIDGE_PORT=8765
CUA_BROWSER_BRIDGE_URL=http://127.0.0.1:8765
CUA_LIVE_AGENT_ENABLED=true
# Simpan hanya di .env lokal. Jangan commit API key.
GEMINI_API_KEY=
CUA_PLANNER_PROVIDER=gemini
CUA_PLANNER_MODEL=gemini-3.7-flash
CUA_PLANNER_FALLBACK_MODEL=gemini-3.6-flash
# Retry 429/5xx sebelum memakai fallback. Maksimum yang diterima aplikasi: 6.
CUA_GEMINI_MAX_RETRIES=3
# Panduan suara Gemini Indonesia. Browser TTS tetap dapat menjadi fallback di UI.
CUA_TTS_ENABLED=true
CUA_TTS_PROVIDER=gemini
CUA_TTS_MODEL=gemini-3.1-flash-tts-preview
CUA_TTS_VOICE=Sulafat
# Transkripsi mikrofon real-time. Model ini hanya STT, bukan TTS.
CUA_STT_MODEL=gemini-3.5-transcribe-live
# Checkpoint LangGraph menolak deserialisasi object arbitrary dari database.
LANGGRAPH_STRICT_MSGPACK=true
# Dokumentasi kebijakan: raw audio 0 hari, audit 90 hari, transcript 30 hari.
CUA_AUDIT_RETENTION_DAYS=90
CUA_TRANSCRIPT_RETENTION_DAYS=30
